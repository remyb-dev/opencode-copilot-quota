{
  "name": "opencode-copilot-quota",
  "version": "0.1.0",
  "description": "opencode TUI plugin that shows your GitHub Copilot premium quota (remaining credits, daily budget, end-of-month projection) in the session sidebar",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "github-copilot",
    "copilot",
    "quota",
    "tui"
  ],
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.17.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@opencode-ai/plugin": "^1.18.0",
    "@opentui/core": "^0.6.3",
    "@opentui/solid": "^0.6.3",
    "@types/node": "^22.0.0",
    "@opentui/keymap": "^0.6.3",
    "babel-preset-solid": "1.9.12",
    "solid-js": "1.9.12",
    "typescript": "^5.6.0"
  }
}
